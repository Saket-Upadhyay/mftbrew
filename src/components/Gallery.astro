---
// Files in `public/` are served at the site root — reference them from '/images'
import { readdirSync, statSync } from "node:fs";
import path from "node:path";
import sharp from "sharp";

// Read the public/images directory at build time and create root-relative URLs.
// Use process.cwd() so this works during build (dist prerender) and dev.
// Files in `public/` are served at '/' so reference them as '/images/<name>'.
const imagesDir = path.join(process.cwd(), "public", "images");
const thumbsDir = path.join(imagesDir, "thumbs");

// sharp returns exif as a raw Buffer; scan it for the first ASCII date string.
// EXIF stores dates as "YYYY:MM:DD HH:MM:SS" — DateTimeOriginal appears before DateTime in most cameras.
function dateFromExifBuffer(buf: Buffer): number | null {
    const str = buf.toString("latin1");
    const m = str.match(/(\d{4}):(\d{2}):(\d{2}) (\d{2}):(\d{2}):(\d{2})/);
    if (!m) return null;
    const d = new Date(`${m[1]}-${m[2]}-${m[3]}T${m[4]}:${m[5]}:${m[6]}`);
    return isNaN(d.getTime()) ? null : d.getTime();
}

let allFiles: string[];
try {
    const files = readdirSync(imagesDir).filter((f: string) => /\.(jpe?g|png|webp)$/i.test(f));
    const withDates = await Promise.all(
        files.map(async (name: string) => {
            const filePath = path.join(imagesDir, name);
            let date: number;
            try {
                const meta = await sharp(filePath).metadata();
                date = (meta.exif ? dateFromExifBuffer(meta.exif) : null)
                    ?? statSync(filePath).birthtime.getTime();
            } catch {
                date = statSync(filePath).birthtime.getTime();
            }
            return { name, date };
        })
    );
    allFiles = withDates.sort((a, b) => b.date - a.date).map((e) => e.name);
} catch (err) {
    allFiles = [];
}

const thumbFiles = new Set<string>(
    (() => {
        try {
            return readdirSync(thumbsDir);
        } catch {
            return [] as string[];
        }
    })()
);

const base = import.meta.env.BASE_URL;

type ImageEntry = {
    name: string;
    full: string;
    thumb: string;
};

const images: ImageEntry[] = allFiles
    .map((name: string) => {
        const thumbExists = thumbFiles.has(name);
        return {
            name,
            full: `${base}/images/${name}`,
            thumb: thumbExists ? `${base}/images/thumbs/${name}` : `${base}/images/${name}`,
        };
    });
---

<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4"
     style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px;padding:0 1%;box-sizing:border-box;">
    {
        images.map((img, i) => (
                <img
                        src={img.thumb}
                        alt=""
                        loading={i === 0 ? "eager" : "lazy"}
                        data-index={i}
                        data-full={img.full}
                        tabindex="0"
                        style="width:100%;aspect-ratio:1/1;object-fit:cover;display:block;border-radius:0.5rem;cursor:pointer;"
                />
        ))
    }
</div>

<!-- Lightbox overlay for focused image view -->
<div id="lightbox" aria-hidden="true">
    <img id="lightbox-img" src="" alt="" />
    <div class="lightbox-controls" aria-hidden="false">
        <button id="lightbox-prev" aria-label="Previous">&#129128;</button>
        <button id="lightbox-close" aria-label="Close">&#128473;</button>
        <button id="lightbox-next" aria-label="Next">&#129130;</button>
    </div>
</div>

<!-- Lightbox styles (scoped to component via :global selectors so IDs match existing markup) -->
<style>
  :global(#lightbox) {
    position: fixed;
    inset: 0;
    /* Slightly translucent so backdrop-filter blur is visible */
    background: rgba(0,0,0,0.35);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    transition: opacity 180ms ease;
    /* Backdrop blur for supported browsers */
    -webkit-backdrop-filter: blur(10px) saturate(120%);
    backdrop-filter: blur(10px) saturate(120%);
    /* Subtle vignette to keep focus on center */
    box-shadow: inset 0 0 120px rgba(0,0,0,0.45);
  }

  /* Image fits viewport and fades between changes */
  :global(#lightbox-img) {
    max-width: 90vw;
    max-height: 90vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 0.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    transition: opacity 200ms ease, transform 200ms ease;
    opacity: 0;
    transform: scale(0.98);
    will-change: opacity, transform;
    display: block;
    margin: 0 auto;
  }

  /* Controls positioned at bottom center */
  :global(.lightbox-controls) {
    position: absolute;
    left: 50%;
    bottom: 24px;
    transform: translateX(-50%);
    display: flex;
    gap: 12px;
  }

  :global(#lightbox-prev),
  :global(#lightbox-close),
  :global(#lightbox-next) {
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    background: rgba(0,0,0,0.7);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.2);
    font-size: 24px;
    //line-height: 40px;
    text-align: center;
    cursor: pointer;
  }

  :global(#lightbox-prev:focus),
  :global(#lightbox-close:focus),
  :global(#lightbox-next:focus) {
    outline: none;
    box-shadow: 0 0 0 3px rgba(255,255,255,0.08);
  }

  /* When lightbox is visible, animate opacity and show img */
  :global(#lightbox[aria-hidden="false"]) {
    opacity: 1;
  }

  :global(#lightbox[aria-hidden="false"]) :global(#lightbox-img) {
    opacity: 1;
    transform: scale(1);
  }
</style>

<script type="module" is:inline>
    /** @type {HTMLImageElement[]} */
    const images = Array.from(document.querySelectorAll('[data-index]'));
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const btnClose = document.getElementById('lightbox-close');
    const btnPrev = document.getElementById('lightbox-prev');
    const btnNext = document.getElementById('lightbox-next');

    if (!lightbox || !lightboxImg || !btnClose || !btnPrev || !btnNext || images.length === 0) {
        // No gallery or missing elements; skip lightbox wiring.
    } else {
        let currentIndex = 0;

        // Helper to set image by index with a fade transition
        function setImageByIndex(index) {
            const src = images[index].dataset.full || images[index].getAttribute('src') || '';
            if (!src) return;
            // fade out current image, then switch src and fade in when loaded
            lightboxImg.style.transition = 'opacity 200ms ease, transform 200ms ease';
            lightboxImg.style.opacity = '0';
            lightboxImg.style.transform = 'scale(0.98)';
            // When the new image loads, fade it in
            const onLoad = () => {
                lightboxImg.removeEventListener('load', onLoad);
                // small timeout to ensure opacity transition runs
                requestAnimationFrame(() => requestAnimationFrame(() => {
                    lightboxImg.style.opacity = '1';
                    lightboxImg.style.transform = 'scale(1)';
                }));
            };
            lightboxImg.addEventListener('load', onLoad);
            lightboxImg.src = src;
        }

        function showLightbox(index) {
            currentIndex = index;
            const fullSrc = images[index].dataset.full || images[index].getAttribute('src');
            if (!fullSrc) return;
            // Ensure element is visible so CSS transitions apply
            lightbox.style.display = 'flex';
            // Allow CSS to handle opacity via aria-hidden attribute
            lightbox.setAttribute('aria-hidden', 'false');
            // Prevent background scroll while lightbox is open
            document.body.style.overflow = 'hidden';
            // Set image with fade
            setImageByIndex(index);
            // trap focus on close button
            btnClose.focus();
        }

        function closeLightbox() {
            // Start CSS-driven fade-out
            lightbox.setAttribute('aria-hidden', 'true');
            // Restore background scrolling
            document.body.style.overflow = '';
            // display will be set to 'none' after transitionend listener
        }

        function showNext() {
            currentIndex = (currentIndex + 1) % images.length;
            setImageByIndex(currentIndex);
        }

        function showPrev() {
            currentIndex = (currentIndex - 1 + images.length) % images.length;
            setImageByIndex(currentIndex);
        }

        // After CSS opacity transition finishes on the lightbox, hide it from layout when closed
        lightbox.addEventListener('transitionend', (e) => {
            if (e.target !== lightbox || e.propertyName !== 'opacity') return;
            if (lightbox.getAttribute('aria-hidden') === 'true') {
                lightbox.style.display = 'none';
                // clear image src to free memory
                lightboxImg.src = '';
            }
        });

        images.forEach((img, i) => {
            img.addEventListener('click', () => showLightbox(i));
            img.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') showLightbox(i);
            });
        });

        btnClose.addEventListener('click', closeLightbox);
        btnNext.addEventListener('click', showNext);
        btnPrev.addEventListener('click', showPrev);

        lightbox.addEventListener('click', (e) => {
            // close when clicking backdrop (not the image)
            if (e.target === lightbox) closeLightbox();
        });

        document.addEventListener('keydown', (e) => {
            // If lightbox is not visible (display none) ignore
            if (lightbox.style.display === 'none') return;
            if (e.key === 'Escape') closeLightbox();
            if (e.key === 'ArrowRight') showNext();
            if (e.key === 'ArrowLeft') showPrev();
        });
    }
</script>
